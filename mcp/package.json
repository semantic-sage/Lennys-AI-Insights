{
  "name": "lennys-podcast-mcp",
  "version": "1.0.0",
  "description": "MCP server for Lenny's Podcast: ask which episodes teach a topic and get episodes, takeaways, quotes and links.",
  "type": "module",
  "bin": { "lennys-podcast-mcp": "dist/index.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "prebuild": "npm run sync-data",
    "build": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "test": "npm run build && vitest run",
    "prepublishOnly": "node scripts/sync-data.mjs --strict && npm run build",
    "start": "node dist/index.js"
  },
  "keywords": ["mcp", "model-context-protocol", "podcast", "lenny", "product-management"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/semantic-sage/Lennys-AI-Insights", "directory": "mcp" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
